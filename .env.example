# Copy this file to .env.local and fill in only the integrations you want to test.
# Never commit real tokens, webhook URLs, or API keys.

# GitHub Projects read-only board.
# Required only when testing the GitHub Projects surface.
GITHUB_TOKEN=
GITHUB_USER=
GITHUB_ORG=
GITHUB_PROJECT_NUMBER=
# Optional comma-separated alternative for loading multiple project numbers.
GITHUB_PROJECT_NUMBERS=

# GitHub Activity read-only feed.
# Required only when testing recent commits, pull requests, and issues for one repo.
GITHUB_REPO=

# GitHub Workspace read-only overview.
# Required only when testing multiple repositories in the workspace view.
GITHUB_OWNER=
GITHUB_REPOS=

# Optional OpenAI draft generation.
OPENAI_API_KEY=
# Optional model override. Leave empty to use the app default.
OPENAI_MODEL=

# Optional Discord manual sends.
# Used only by explicit user actions; the app does not auto-post in the background.
DISCORD_DASHBOARD_WEBHOOK_URL=

# Optional public weather demo card.
# Leave empty to avoid fetching weather for a real location.
NEXT_PUBLIC_WEATHER_LATITUDE=
NEXT_PUBLIC_WEATHER_LONGITUDE=
